{
  "version": 2,
  "appearance": {
    "background": "#101827",
    "surface": "#172133",
    "text": "#e4eaf5",
    "muted": "#8d9bb2",
    "accent": "#adbded",
    "fontFamily": "system-ui",
    "fontSize": 13,
    "sidebarWidth": 236,
    "sidebarCollapsedWidth": 64,
    "sidebarCollapsed": false,
    "toolbarHeight": 54,
    "tabHeight": 38,
    "cornerRadius": 10,
    "showSearchHints": true,
    "reduceMotion": false,
    "material": "solid",
    "backgroundOpacity": 0.84,
    "surfaceOpacity": 0.72,
    "blur": 24,
    "window": { "transparent": false, "opacity": 1 },
    "cssVariables": {},
    "customCSS": ""
  },
  "search": {
    "default": "ddg",
    "engines": [
      {
        "id": "ddg",
        "name": "DuckDuckGo",
        "keyword": "d",
        "url": "https://duckduckgo.com/?q={query}"
      },
      {
        "id": "youtube",
        "name": "YouTube",
        "keyword": "y",
        "url": "https://www.youtube.com/results?search_query={query}"
      },
      {
        "id": "google",
        "name": "Google",
        "keyword": "g",
        "url": "https://www.google.com/search?q={query}"
      },
      {
        "id": "github",
        "name": "GitHub",
        "keyword": "gh",
        "url": "https://github.com/search?q={query}"
      },
      {
        "id": "wikipedia",
        "name": "Wikipedia",
        "keyword": "w",
        "url": "https://en.wikipedia.org/w/index.php?search={query}"
      }
    ]
  },
  "tabs": {
    "restore": "pinned",
    "sleepAfterMinutes": 15,
    "maxOpen": 80,
    "confirmCloseWindow": true
  },
  "privacy": {
    "doNotTrack": true,
    "globalPrivacyControl": true,
    "blockThirdPartyCookies": true,
    "blockTrackers": true,
    "blockedHosts": [
      "doubleclick.net",
      "google-analytics.com",
      "googlesyndication.com",
      "connect.facebook.net",
      "analytics.tiktok.com",
      "hotjar.com"
    ],
    "permissions": {
      "camera": "ask",
      "microphone": "ask",
      "geolocation": "block",
      "notifications": "block",
      "clipboard-read": "ask"
    }
  },
  "extensions": { "paths": [] },
  "shortcuts": {
    "newTab": "CommandOrControl+T",
    "closeTab": "CommandOrControl+W",
    "reopenTab": "CommandOrControl+Shift+T",
    "focusAddress": "CommandOrControl+L",
    "toggleSidebar": "CommandOrControl+B",
    "pinTab": "CommandOrControl+Shift+P",
    "settings": "CommandOrControl+,",
    "downloads": "CommandOrControl+J",
    "reload": "CommandOrControl+R",
    "nextTab": "Control+Tab",
    "previousTab": "Control+Shift+Tab"
  }
}
