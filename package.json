{
  "name": "browser",
  "productName": "Browser",
  "version": "0.1.0",
  "description": "A minimal, configurable desktop browser with vertical tabs.",
  "main": "src/main.cjs",
  "author": "orcspace",
  "license": "Apache-2.0",
  "repository": "https://github.com/orcspace/Browser",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/core.test.cjs",
    "test:desktop": "playwright test",
    "check": "node scripts/check.cjs",
    "icons": "node scripts/icons.cjs",
    "pack": "npm run icons && electron-builder --dir",
    "dist:win": "npm run icons && electron-builder --win --x64",
    "dist:mac": "npm run icons && electron-builder --mac --arm64"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "png-to-ico": "3.0.1",
    "sharp": "0.34.5"
  },
  "build": {
    "appId": "space.orc.browser",
    "productName": "Browser",
    "asar": true,
    "files": [
      "src/**/*",
      "config/**/*",
      "assets/**/*",
      "LICENSE",
      "NOTICE",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "artifactName": "Browser-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "Allow websites you approve to use the camera.",
        "NSMicrophoneUsageDescription": "Allow websites you approve to use the microphone.",
        "NSLocationWhenInUseUsageDescription": "Allow websites you approve to use your location."
      }
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "assets/icon.png"
    }
  },
  "dependencies": {
    "tldts": "7.4.28"
  }
}
